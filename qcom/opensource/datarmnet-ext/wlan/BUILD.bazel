ddk_headers(
    name = "rmnet_wlan_include_headers",
    hdrs = glob([
        "include/linux/*.h",
    ]),
    includes = [
        "include",
        "include/linux",
    ],
)

ddk_headers(
    name = "rmnet_wlan_uapi_include_headers",
    hdrs = glob([
        "include/uapi/linux/*.h",
    ]),
    includes = [
        "include/uapi",
    ],
)

ddk_headers(
    name = "include_headers",
    hdrs = [
        ":rmnet_wlan_include_headers",
        ":rmnet_wlan_uapi_include_headers",
    ],
)
