package(
    default_visibility = [
        "//visibility:public",
    ],
)

load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

driver_header_globs = [
    "include/uapi/synx/**/*.h",
    "include/uapi/synx/media/**/*.h",
    "msm/synx/**/*.h",
]

ddk_headers(
    name = "synx_headers",
    hdrs = glob(driver_header_globs),
    includes = [
        "include/uapi/synx",
        "include/uapi/synx/media",
        "msm/synx",
    ],
)

load(":pineapple.bzl", "define_pineapple")

define_pineapple()

load(":niobe.bzl", "define_niobe")

define_niobe()

load(":sun.bzl", "define_sun")

define_sun()

load(":canoe.bzl", "define_canoe")

define_canoe()

load(":chora.bzl", "define_chora")

define_chora()

load(":alor-le.bzl", "define_alor_le")

define_alor_le()

load(":seraph.bzl", "define_seraph")

define_seraph()

load(":autogvm.bzl", "define_autogvm")

define_autogvm()

filegroup(
    name = "dt_binding_headers",
    srcs = glob(["dt-bindings/**/*.h"], allow_empty = False),
    visibility = ["//visibility:public"],
)
